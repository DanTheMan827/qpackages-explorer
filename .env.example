# Normal builds use this public proxy only when the page is not hosted on
# qpackages.com and was not built through Wrangler.
VITE_QPACKAGES_BASE_URL=https://qpackages.com
VITE_PUBLIC_CORS_PROXY_URL=https://api.allorigins.win/raw?url={url}

# Do not normally set VITE_PROXY_MODE yourself. Wrangler uses .env.wrangler,
# while `vite dev` is detected automatically through import.meta.env.DEV.

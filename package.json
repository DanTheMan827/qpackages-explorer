{
  "name": "qpackages-explorer",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:wrangler": "tsc -b && vite build --mode wrangler",
    "preview": "vite preview",
    "preview:worker": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -b --pretty false",
    "audit:schema": "node scripts/audit-schema.mjs",
    "test:transport": "node --experimental-strip-types scripts/test-transport.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "wrangler": "^4.20.0"
  }
}
